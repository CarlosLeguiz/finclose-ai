# --- Anthropic API (AI layer with LangChain) ---
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- DuckDB (local warehouse during development) ---
# Relative path to the .duckdb file (created automatically)
DUCKDB_PATH=./data/finclose.duckdb

# --- Snowflake (only used in week 16 for final validation) ---
# Get it when creating an account at signup.snowflake.com
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FINCLOSE_AI
SNOWFLAKE_SCHEMA=RAW

# --- Airflow (local configuration) ---
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# --- Project metadata ---
PROJECT_NAME=finclose-ai
ENVIRONMENT=development